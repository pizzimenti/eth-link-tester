<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Platform is where the hardware lives, so most of it cannot be unit-tested and should not
    pretend to be. What is testable is the part that decides *whether* to touch hardware: argument
    validation, device-name construction, and the disposed/running state machine. Those are the
    paths a mistake makes silently wrong rather than loudly broken, and none of them needs a NIC.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!-- Versions come from Directory.Packages.props (central package management). -->
  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EthLinkTester.Platform\EthLinkTester.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
