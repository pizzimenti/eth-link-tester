<Project>

  <!--
    Central Package Management. Every NuGet version for the whole solution is pinned here.

    Why this file exists beyond the usual reasons: this machine runs SunUp, which upgrades
    everything winget knows about daily. SunUp does not manage NuGet, so pinning here keeps the
    build reproducible no matter what the machine's toolchain drifts to. See also global.json
    (SDK band) and rust-toolchain.toml (Rust compiler).

    Versions verified against the NuGet API on 2026-08-12.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!--
      Transitive pinning makes every entry below load-bearing, which is why there are no
      placeholders here for packages a later phase will want. A PackageVersion with no matching
      PackageReference is not inert: the moment any dependency pulls that id in transitively, this
      file silently pins it to the version written here. Add the entry when the reference is
      added, not before.
    -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="UI">
    <!-- WinUI 3 / Fluent 2. Note this is a 2.x product now, not 1.x. -->
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Sustained 30-60 Hz strip-chart redraw; chosen over LiveCharts2 for that reason. -->
    <PackageVersion Include="ScottPlot.WinUI" Version="5.1.59" />
  </ItemGroup>

  <ItemGroup Label="Platform interop">
    <!--
      MI, not System.Management. root\StandardCimv2 is an MI-hosted provider: reads work through
      the legacy WMI COM API but ModifyInstance does not, failing with "Object or property already
      exists" and then "Invalid parameter" whatever PutType is supplied. MI is the API
      Set-CimInstance itself wraps, and writing adapter properties is the whole point of Phase 2.
    -->
    <!--
      3.0.0 rather than 4.0.0, and both halves pinned together. The API package carries only
      reference assemblies; the native implementation lives in Runtime.Win, without which
      CimSession.Create throws FileNotFoundException for
      Microsoft.Management.Infrastructure.Native at runtime while compiling perfectly. Runtime.Win
      stops at 3.0.0, so 4.0.0 of the API package has no matching implementation to pair with.
    -->
    <PackageVersion Include="Microsoft.Management.Infrastructure" Version="3.0.0" />
    <PackageVersion Include="Microsoft.Management.Infrastructure.Runtime.Win" Version="3.0.0" />
    <!-- Npcap preflight: proves the capture driver is loaded, not merely installed. -->
    <PackageVersion Include="System.ServiceProcess.ServiceController" Version="10.0.11" />
  </ItemGroup>

  <!--
    Not yet listed, and deliberately so - each lands with the code that uses it:
      Microsoft.Windows.CsWin32        Phase 3, NDIS DeviceIoControl
      Microsoft.Data.Sqlite            Phase 6, runs and cable library
      PDFsharp-MigraDoc                Phase 7, the certification report. MIT with no revenue
                                       clause, unlike QuestPDF's dual licence, and MigraDoc's
                                       document-level layout suits a report better than a
                                       drawing API.
      Microsoft.Extensions.*           when there is an object graph worth injecting. WinUI 3
                                       navigation constructs pages itself, so DI today would buy
                                       a service locator rather than constructor injection.
  -->

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
  </ItemGroup>

</Project>
