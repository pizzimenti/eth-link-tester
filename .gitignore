# ---- .NET ----
bin/
# Rust puts source in src/bin/, which the .NET rule above silently swallowed - the verification
# binaries went uncommitted for a whole phase while a commit message claimed they were tracked.
!engine/src/bin/
!engine/src/bin/**
obj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]64/
*.user
*.suo
*.userprefs
*.binlog
.vs/
artifacts/
TestResults/
*.coverage
*.trx

# NuGet
*.nupkg
*.snupkg
packages/
.nuget/

# ---- Rust ----
target/
**/*.rs.bk
*.pdb

# ---- Tooling / editors ----
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# ---- OS ----
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ---- Project-local ----
# Local run output, captured telemetry, and test databases are not source.
*.ethlink.db
*.ethlink.db-shm
*.ethlink.db-wal
/samples/captures/
/local/
