<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>EthLinkTester.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWinUI>true</UseWinUI>
    <!--
      Unpackaged is not a convenience choice. Raw packet injection and NDIS property
      writes require administrator, and packaged (MSIX) apps cannot request elevation.
    -->
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!--
      Bundle the Windows App SDK runtime rather than requiring users to install it.
      They already have to install Npcap by hand (its license forbids redistribution);
      making them install a second runtime as well is a needless barrier.
    -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>EthLinkTester</AssemblyName>
  </PropertyGroup>

  <!--
    Simulation is a Debug-only feature. Contributors building from source get the full UI with
    no NICs and no Npcap installed, while a released binary contains no code path that can
    render synthetic data as though it were a measurement.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>$(DefineConstants);SIMULATION</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="ScottPlot.WinUI" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EthLinkTester.Core\EthLinkTester.Core.csproj" />
  </ItemGroup>

</Project>
