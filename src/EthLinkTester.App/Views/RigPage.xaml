<Page
    x:Class="EthLinkTester.App.Views.RigPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:EthLinkTester.App.Controls">

    <c:PhaseStub Heading="Rig"
                 PhaseLabel="Phase 2"
                 Summary="Adapter pair selection, live link state, capability probe, and the topology verdict. This is the page you start a run from.">
        <c:PhaseStub.Details>
            <StackPanel Spacing="8">
                <TextBlock TextWrapping="Wrap" Text="• Two adapter cards showing negotiated speed, duplex, and hardware error counters updating live" />
                <TextBlock TextWrapping="Wrap" Text="• Capability probe derives which speed tiers this rig can actually reach, rather than implying full coverage" />
                <TextBlock TextWrapping="Wrap" Text="• Topology verdict: direct cable or a switch in the middle, with the confidence signals that decided it" />
                <TextBlock TextWrapping="Wrap" Text="• Bus headroom, so a bottleneck can be attributed to the fixture instead of the cable" />
                <TextBlock TextWrapping="Wrap" Text="• Golden-cable baseline status" />
            </StackPanel>
        </c:PhaseStub.Details>
    </c:PhaseStub>
</Page>
